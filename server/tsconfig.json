{
  // Settings for the type checker (npm run typecheck). Node itself ignores this file:
  // it runs the .ts files directly by stripping out the types.
  "compilerOptions": {
    // Modern JavaScript output features; nothing is emitted, but this sets what tsc accepts.
    "target": "es2024",
    // Node's own module rules: ES modules here, because package.json says "type": "module".
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Type definitions to load: only Node's, from @types/node.
    "types": ["node"],
    // Check only, never write .js files. Node runs the .ts files as they are.
    "noEmit": true,
    // Lets imports keep their .ts extension, which Node needs to find the file.
    "allowImportingTsExtensions": true,
    // Rejects TypeScript-only syntax Node cannot strip, such as enum and namespace.
    "erasableSyntaxOnly": true,
    // Type-only imports must say `import type`, so Node knows it can delete them.
    "verbatimModuleSyntax": true,
    // All the strict checks, such as no implicit any and null checks.
    "strict": true,
    // Reading array[i] or obj[key] may give undefined, so the code must handle it.
    "noUncheckedIndexedAccess": true,
    // Skips checking the .d.ts files inside node_modules, which is slow and not our code.
    "skipLibCheck": true
  },
  // The server's own code, its tests and the shared types.
  "include": ["src", "test", "vitest.config.ts", "prisma.config.ts", "../shared"]
}
