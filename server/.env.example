# Every variable the server reads. Copy this file to .env and fill it in; .env is never
# committed. For the tests, copy it to .env.test with the weather_test database instead.

# Required. The database the app queries. Locally a plain PostgreSQL URL; on Render, Neon's
# pooled connection string.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/weather_dev

# On Neon only: the direct (unpooled) connection string, which migrations need.
DIRECT_URL=

# Optional. The Consumer Key of a Ticketmaster developer app. Without it the server still
# runs, and the events part of each card says events are off.
TICKETMASTER_API_KEY=

# Optional. The port to listen on; Render sets it. Defaults to 3000.
PORT=
